# SQLite for the MVP. Change to a Postgres URL later;
# the schema needs no other changes.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Change this in production.
SESSION_SECRET="dev-only-secret-change-me-0123456789abcdef"

# Optional. Leave empty to run without an LLM (schema-driven mode).
# Any OpenAI-compatible endpoint works, for example:
#   LLM_API_BASE="https://api.openai.com/v1"
#   LLM_MODEL="gpt-4o-mini"
LLM_API_BASE=""
LLM_API_KEY=""
LLM_MODEL=""
